__tc_set_scheme default

__tc_R='\[\e[0m\]'        # reset all
__tc_B='\[\e[1m\]'        # bold

# Nerd Font glyphs — stored via $'\uNNNN' so they survive file encoding
#   U+E0B6  rounded left cap  — opens each line's capsule
#   U+E0B0  filled right arrow — inner segment separator
#   U+E0B4  rounded right cap  — closes the capsule
#   U+E0A0  git branch icon · U+F007 user · U+F07B folder · U+F017 clock
#   U+F1DA  history (clock with back-arrow)
__tc_ARR=$''
__tc_CAP_R=$''
__tc_GIT=$''
__tc_CAP_L=$''
__tc_USR=$''
__tc_DIR=$''
__tc_CLK=$''
__tc_HIS=$''

# Give every status flag its own color, mirroring the default prompt's scheme
# in dim mocha: + staged green, * modified red, ? untracked peach, ^N ahead
# sky, vN behind mauve (digits inherit their arrow's color). Result in
# __tc_flags_colored; the caller restores its base color afterwards.
__tc_colorize_flags() {
  __tc_flags_colored=""
  local flags=$1 i ch cur=""
  for ((i = 0; i < ${#flags}; i++)); do
    ch=${flags:i:1}
    case "$ch" in
      '+') cur=$__tc_fg_green ;;
      '*') cur=$__tc_fg_red ;;
      '?') cur=$__tc_fg_peach ;;
      '^') cur=$__tc_fg_sky ;;
      'v') cur=$__tc_fg_mauve ;;
    esac
    __tc_flags_colored+="${cur}${ch}"
  done
}

__tc_build_ps1() {
  local last_status=${1:-0}

  # ── path ──────────────────────────────────────────────────────────────────
  local path
  if declare -f __sd_prompt_path_segment >/dev/null 2>&1; then
    __sd_prompt_path_segment
    path="$__sd_prompt_path_value"
  else
    path='\w'
  fi

  # ── git ───────────────────────────────────────────────────────────────────
  # The pill stays dark; clean/dirty shows in the TEXT color only.
  local has_git=0 branch="" flags="" git_fg=""
  if declare -f __sd_git_find >/dev/null 2>&1 && __sd_git_find 2>/dev/null; then
    __sd_git_head_name "$__sd_git_dir" 2>/dev/null
    __sd_git_status_flags_cached "$__sd_git_repo_root" 2>/dev/null
    branch="$__sd_git_head_value"
    flags="$__sd_git_status_flags"
    has_git=1
    if [[ -n "$flags" && "$flags" != $'\xe2\x80\xa6' && "$flags" != "..." ]]; then
      git_fg="$__tc_fg_teal"
    else
      git_fg="$__tc_fg_pink"
    fi
  fi

  # ── line 1: user@host + directory ─────────────────────────────────────────
  #
  #   (  user@host ▶   ~/path )
  #   ^— rounded left cap      ^— rounded right cap

  # Same host trick as .bash_prompt: strip codespaces' random name suffix;
  # otherwise plain short hostname.
  local cs_host="${CODESPACE_NAME%-*}"
  [[ -z "$cs_host" ]] && cs_host="${HOSTNAME%%.*}"

  # Rounded left cap + Seg 1: user icon + user@host [mauve user · gray @ ·
  # blue host, all on the crust pill]
  local p="${__tc_R}${__tc_fg_s0}${__tc_CAP_L}${__tc_bg_s0}${__tc_fg_mauve}${__tc_B}${__tc_USR}  \\u${__tc_fg_gray}@${__tc_fg_blue}${cs_host} "

  # Inner arrow (crust → mantle) + Seg 2: folder icon + path [dim green]
  p+="${__tc_bg_s1}${__tc_fg_s0}${__tc_ARR}${__tc_fg_green}${__tc_B} ${__tc_DIR}  ${path} "
  p+="${__tc_R}${__tc_fg_s1}${__tc_CAP_R}${__tc_R}"

  # ── line 2: time + git status + prompt character ──────────────────────────
  #
  #   (  HH:MM ▶   branch flags ) ❯     (time capsule + ❯ when not in git)
  local char
  if (( last_status == 0 )); then
    char="${__tc_fg_green}${__tc_B}❯${__tc_R} "
  else
    char="${__tc_fg_red}${__tc_B}❯${__tc_R} "
  fi

  # Rounded left cap + time [gray on crust — \t is bash's HH:MM:SS] + history
  # number [sky — N as shown recalls that command with !N]
  local line2="${__tc_fg_s0}${__tc_CAP_L}${__tc_bg_s0}${__tc_fg_gray}${__tc_B}${__tc_CLK}  \\t ${__tc_fg_sky}${__tc_HIS} \\! "
  if (( has_git )); then
    # Inner arrow (crust → mantle) + git seg; base accent in the text (dim
    # pink = clean, dim teal = dirty/pending) with per-flag colors after the
    # branch name, restoring the base color for the trailing pad.
    local git_label="${__tc_GIT} ${branch}"
    if [[ -n "$flags" ]]; then
      if [[ "$flags" == $'\xe2\x80\xa6' || "$flags" == "..." ]]; then
        git_label+="  ${flags}"
      else
        __tc_colorize_flags "$flags"
        git_label+="  ${__tc_flags_colored}${git_fg}"
      fi
    fi
    line2+="${__tc_bg_s1}${__tc_fg_s0}${__tc_ARR}${git_fg}${__tc_B} ${git_label} "
    line2+="${__tc_R}${__tc_fg_s1}${__tc_CAP_R}${__tc_R} "
  else
    line2+="${__tc_R}${__tc_fg_s0}${__tc_CAP_R}${__tc_R} "
  fi
  line2+="${char}"

  PS1="${p}\n${line2}"
}

__tc_prompt_command() {
  local s=$?
  # Per-prompt history flush — see the twin comment in .bash_prompt's
  # __sd_prompt_command (file-searching Ctrl+R needs it; up-arrow unaffected).
  builtin history -a
  __tc_build_ps1 "$s"
}

# Scrub any stale prompt-tc alias/abbreviation from a long-lived shell: the
# old .bash_aliases registered an abbrev-alias, and bash-abbrev-alias's
# space-key expansion reads its _abbrev_aliases array — which re-sourcing
# .bash_aliases does NOT clear. Without this, typing "prompt-tc " expands to
# the old PROMPT_COMMAND string and swallows the scheme/-h argument.
unalias prompt-tc 2>/dev/null
unset '_abbrev_aliases[prompt-tc]' 2>/dev/null

# Switch to this prompt, optionally picking a color scheme:
#   prompt-tc                keep the current scheme (default on first use)
#   prompt-tc <scheme>       switch scheme + prompt in one go
#   prompt-tc -h             list available schemes
# (A function, not an alias, so it can take the scheme argument. Declared with
# the `function` keyword on purpose: with the old alias still active in a
# long-lived shell, the `prompt-tc() {` form would alias-expand at parse time
# and abort sourcing this whole file with a syntax error; after `function`,
# the name is not in command position, so no expansion happens.)
function prompt-tc {
  case "${1:-}" in
    -h|--help)
      printf 'Usage: prompt-tc [scheme]\n\nSchemes:\n'
      printf '  %-12s %s\n' \
        "default"     "near-black pills · dimmed catppuccin-mocha pastels" \
        "catppuccin"  "catppuccin mocha · surface pills, full pastel accents" \
        "monokai-pro" "monokai pro classic · charcoal pills, monokai accents" \
        "tokyonight"  "tokyonight storm · navy pills, blue/cyan family" \
        "material"    "material deep-ocean · blue-black pills, material accents" \
        "kanagawa"    "kanagawa wave · sumi-ink pills, muted zen accents" \
        "cyberdream"  "cyberdream · neon accents on near-black (the loud one)"
      printf '\nCurrent scheme: %s. prompt-sd switches back to the plain prompt.\n' \
        "${__tc_scheme:-default}"
      return 0
      ;;
    "") ;;
    *)
      if ! __tc_set_scheme "$1"; then
        echo "prompt-tc: unknown scheme '$1' (see: prompt-tc -h)" >&2
        return 1
      fi
      ;;
  esac
  PROMPT_COMMAND="__tc_prompt_command"
  # Recolor the nvim-bash vi mode pill to this scheme (defined in
  # .bash_aliases; a no-op unless the shell is in vi editing mode).
  ! declare -F __nvim_bash_rebind >/dev/null || __nvim_bash_rebind
  echo "switched to TypeCraft prompt (${__tc_scheme} scheme)"
}

fi
