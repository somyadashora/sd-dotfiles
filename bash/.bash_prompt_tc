if [[ $- == *i* ]]; then

# ──────────────────────────────────────────────────────────────────────────────
#  TypeCraft-inspired powerline prompt  (Catppuccin Macchiato · Nerd Fonts required)
#
#  Switch to this prompt:   prompt-tc
#  Switch back to default:  prompt-default
#
#  Visual structure (matches TypeCraft style):
#    ▶ user ▶ ~/path ▶  branch flags
#    ^— sharp opening arrow (U+E0B0)
#                  ^— sharp inner arrows (U+E0B0)
#                                        ^— rounded right cap (U+E0B4)
# ──────────────────────────────────────────────────────────────────────────────

# Catppuccin Macchiato — muted dark-pastel palette
#
# NOTE: every comment MUST have a space before # — bash parses VAR='val'#word
#       as setting VAR to 'val'# and then running `word` as a command.

__tc_bg_mauve='\[\e[48;2;198;160;246m\]'   # mauve  #c6a0f6 — user
__tc_bg_sage='\[\e[48;2;166;218;149m\]'    # sage   #a6da95 — directory (pastel green)
__tc_bg_pink='\[\e[48;2;245;189;230m\]'    # pink   #f5bde6 — git clean
__tc_bg_sky='\[\e[48;2;145;215;227m\]'     # sky    #91d7e3 — git dirty

__tc_fg_base='\[\e[38;2;36;39;58m\]'       # base   #24273a — text on segments
__tc_fg_mauve='\[\e[38;2;198;160;246m\]'   # mauve  — arrow/cap fg
__tc_fg_sage='\[\e[38;2;166;218;149m\]'    # sage   — arrow/cap fg
__tc_fg_pink='\[\e[38;2;245;189;230m\]'    # pink   — arrow/cap fg
__tc_fg_sky='\[\e[38;2;145;215;227m\]'     # sky    — arrow/cap fg
__tc_fg_green='\[\e[38;2;166;218;149m\]'   # green  — success ❯
__tc_fg_red='\[\e[38;2;237;135;150m\]'     # red    — error ❯

__tc_R='\[\e[0m\]'        # reset all
__tc_B='\[\e[1m\]'        # bold

# Nerd Font glyphs — stored via $'\uNNNN' so they survive file encoding
#   U+E0B0  filled right arrow — opening + inner segment separator
#   U+E0B4  rounded right cap  — closing (right end of last segment)
#   U+E0A0  git branch icon
__tc_ARR=$''
__tc_CAP_R=$''
__tc_GIT=$''

__tc_build_ps1() {
  local last_status=${1:-0}

  # ── path ──────────────────────────────────────────────────────────────────
  local path
  if declare -f __sd_prompt_path_segment >/dev/null 2>&1; then
    __sd_prompt_path_segment
    path="$__sd_prompt_path_value"
  else
    path='\w'
  fi

  # ── git ───────────────────────────────────────────────────────────────────
  local has_git=0 branch="" flags="" git_bg="" git_fg=""
  if declare -f __sd_git_find >/dev/null 2>&1 && __sd_git_find 2>/dev/null; then
    __sd_git_head_name "$__sd_git_dir" 2>/dev/null
    __sd_git_status_flags_cached "$__sd_git_repo_root" 2>/dev/null
    branch="$__sd_git_head_value"
    flags="$__sd_git_status_flags"
    has_git=1
    if [[ -n "$flags" && "$flags" != $'\xe2\x80\xa6' && "$flags" != "..." ]]; then
      git_bg="$__tc_bg_sky"
      git_fg="$__tc_fg_sky"
    else
      git_bg="$__tc_bg_pink"
      git_fg="$__tc_fg_pink"
    fi
  fi

  # ── build line 1 ──────────────────────────────────────────────────────────
  #
  #   ▶ user ▶ ~/path ▶  branch flags
  #   ^        ^          ^            ^
  #   opening  inner arr  inner arr    rounded right cap

  # Opening arrow (no bg → mauve) + Seg 1: username only [mauve, bold]
  local p="${__tc_R}${__tc_fg_mauve}${__tc_ARR}${__tc_bg_mauve}${__tc_fg_base}${__tc_B}  \\u "

  # Inner arrow (mauve → sage) + Seg 2: directory [pastel green, bold]
  p+="${__tc_bg_sage}${__tc_fg_mauve}${__tc_ARR}${__tc_fg_base}${__tc_B}  ${path} "

  # Inner arrow + Seg 3: git [pink=clean · sky=dirty, bold] + rounded right cap
  if (( has_git )); then
    local git_label="${__tc_GIT} ${branch}"
    [[ -n "$flags" ]] && git_label+="  ${flags}"
    p+="${git_bg}${__tc_fg_sage}${__tc_ARR}${__tc_fg_base}${__tc_B}  ${git_label} "
    p+="${__tc_R}${git_fg}${__tc_CAP_R}${__tc_R}"
  else
    # No git — rounded cap closes after directory
    p+="${__tc_R}${__tc_fg_sage}${__tc_CAP_R}${__tc_R}"
  fi

  # ── line 2: prompt character (bold) ───────────────────────────────────────
  local char
  if (( last_status == 0 )); then
    char="${__tc_fg_green}${__tc_B}❯${__tc_R} "
  else
    char="${__tc_fg_red}${__tc_B}❯${__tc_R} "
  fi

  PS1="${p}\n${char}"
}

__tc_prompt_command() {
  local s=$?
  __tc_build_ps1 "$s"
}

fi
