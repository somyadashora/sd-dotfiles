
# echo "Sourcing sdashora's bashrc"
# export DOTFILES_DIR="${HOME}/.somyadashora/sd-dotfiles"
# source "${DOTFILES_DIR}/bash/.bash_rc"

# The above should be the last lines before jumping into this file
# copying for usage in new env


# Setup fzf
# ---------
if [[ ! "$PATH" == ${HOME}/.fzf/bin* ]]; then
  PATH="${PATH:+${PATH}:}${HOME}/.fzf/bin"
  eval "$(fzf --bash)"
fi

# fzf colors/layout/previews (catppuccin mocha, mauve accent) + cheatsheet
source "$DOTFILES_DIR/fzf/fzf.bash"

# ripgrep defaults (smart-case, -tsv type, catppuccin colors) — rg has no
# default config location, it only reads this env var
export RIPGREP_CONFIG_PATH="$DOTFILES_DIR/rg/ripgreprc"

# bash-abbrev-alias (interactive only — bind calls warn in non-interactive shells)
_abbrev_alias_script="${HOME}/.somyadashora/sd-tools/abbrev-alias/abbrev-alias.plugin.bash"
[[ $- == *i* && -f "$_abbrev_alias_script" ]] && source "$_abbrev_alias_script"
unset _abbrev_alias_script

# Pager
export PAGER=delta

shopt -s histappend
PROMPT_COMMAND="history -a;$PROMPT_COMMAND"

source "$DOTFILES_DIR/bash/.bash_aliases"
source "$DOTFILES_DIR/bash/.bash_prompt"
source "$DOTFILES_DIR/bash/.bash_prompt_tc"

# Startup prompt + color scheme for new shells (silenced; prompt-sd/prompt-tc
# only exist in interactive shells — the prompt files guard on $-). Change the
# scheme here, or per-shell with `prompt-sd <scheme>` / `prompt-tc <scheme>`.
[[ $- == *i* ]] && prompt-sd kanagawa >/dev/null




