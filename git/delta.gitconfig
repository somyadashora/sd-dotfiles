# ============================================================
#  Delta pager config
#  Usage: Add the following line to your ~/.gitconfig:
#
#    [include]
#        path = /path/to/this/delta.gitconfig
#
# ============================================================

[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    side-by-side = true
    line-numbers = true
    syntax-theme = Dracula
