#!/usr/bin/env python3
"""Regenerate the printable keymap art from sofle.keymap.

Three outputs, all committed so nobody needs this script just to READ them:

  keymap.svg  vector, a real A4 page -- print it at 100%
  keymap.png  raster, for a phone or a quick look
  keymap.txt  ASCII, for `sofle-cs` in a terminal over ssh

All three are derived from the .keymap file, never hand-drawn, so a diagram
that disagrees with the firmware is impossible rather than merely unlikely.

keymap.txt is deliberately **pure 7-bit ASCII**. Box-drawing characters and
the nice-looking transparent glyph U+25BD are East Asian *Ambiguous* width:
a terminal with a Nerd Font or a CJK locale renders them two columns wide,
and the grid shears apart. `+---+` and `|` are one column everywhere. The
width assertion at the end of render() is what keeps it that way.

Requires keymap-drawer (`pip install keymap-drawer`) for the parse and the
SVG; rsvg-convert (librsvg2-bin) for the PNG. Missing rsvg-convert only skips
the PNG -- the SVG and the ASCII sheet still regenerate.

    ./scripts/gen-keymap-art
"""

import copy
import html
import re
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent.parent
KEYMAP = HERE / "sofle.keymap"
DRAWER_CFG = HERE / "keymap-drawer.yaml"

# Sofle, 60 positions. Rows of (left indices, right indices); the two encoder
# push-buttons (42, 43) sit in the middle gap of row 3.
ROWS = [
    (range(0, 6), range(6, 12)),
    (range(12, 18), range(18, 24)),
    (range(24, 30), range(30, 36)),
    (range(36, 42), range(44, 50)),
]
ENCODER_BTNS = (42, 43)

# A layer whose ONLY content is knob bindings gets folded into the base sheet
# rather than drawn as its own. Its keys are transparent by construction, so a
# sheet of its own is a full page of the transparent glyph carrying two lines
# of knob text -- and it costs a fifth of the page budget, which is the whole
# A4 legibility argument below. The knob lines land under base's instead,
# labelled with the key you hold to reach them.
FOLDED = {"alt-tab": "ALT"}

# The sheet is a page, not an image: A4 portrait with a real margin, so
# printing it is WYSIWYG at 100% instead of a strip down the middle of the
# paper. MIN_LEGEND_PT is the assertion that keeps it that way -- a fifth
# layer drawn full-size would push the 14px legends under 5pt, which is the
# point at which this stops being a reference you can read at arm's length.
A4_MM = (210.0, 297.0)
MARGIN_MM = 10.0
MIN_LEGEND_PT = 5.8
PNG_DPI = 200
THUMBS = (range(50, 55), range(55, 60))

W = 7                       # cell content width
HALF = 6 * (W + 1) + 1      # rendered width of one half: 49
GAP = " " * 11              # between the halves; also holds the encoder buttons
INDENT = "  "
WIDTH = len(INDENT) + HALF + len(GAP) + HALF

TRANS = "..."               # keymap-drawer says U+25BD; ASCII says this

# Vertical placement of the SVG legends, in em, relative to the alphabetic
# baseline. keymap-drawer positions them with `dominant-baseline` instead,
# which librsvg -- the PNG renderer -- ignores outright: measured on 2.48,
# `middle`, `hanging`, `central` and `auto` all land on the plain alphabetic
# baseline. So its centred tap legends drew ~5px high and its `hanging` top
# legends drew ENTIRELY ABOVE the key, which is the text-outside-the-box in
# the PNG. keymap-drawer.yaml pins every legend to the alphabetic baseline
# and the offsets below reproduce the intended placement with `dy`, which
# librsvg does honour. em, not px, so a shrunk wide legend shifts by its own
# font size rather than the class default.
#
#   0.35em  what `dominant-baseline: middle` did: half a cap height down
#   0.72em  what `hanging` did: one cap height down, so the cap top sits
#           exactly on the anchor point
#   0       already on the alphabetic baseline; nothing to do
#
# Keyed on the legend-type class, which every text element carries exactly one
# of ("key tap", "combo shifted", "key trans tap", "label", ...).
LEGEND_DY = {
    "tap": 0.35, "left": 0.35, "right": 0.35, "label": 0.35,
    "shifted": 0.72, "tl": 0.72, "tr": 0.72,
    "hold": 0.0, "bl": 0.0, "br": 0.0, "footer": 0.0,
}

# Only applied to legends that would otherwise overflow a cell. A shortened
# legend beats a truncated one.
SQUEEZE = [("SPACE", "SPC"), ("CLR ALL", "CLRA"), ("PAUSE BREAK", "PAUSE")]


def run(*args, **kw):
    return subprocess.run(args, check=True, text=True, capture_output=True, **kw).stdout


def legend(entry):
    """keymap-drawer entry -> (tap, shifted, hold). str or {t:,h:,s:}."""
    if isinstance(entry, dict):
        # A bare {type: held} is the key you are holding to be on this layer;
        # it carries no legend of its own, and an empty cell there reads as a
        # hole in the layout rather than as the thing that got you here.
        if not entry.get("t") and entry.get("type") == "held":
            return "HELD", "", ""
        return (str(entry.get("t", "")),
                str(entry.get("s", "")),
                str(entry.get("h", "")))
    return str(entry), "", ""


def fit(text):
    text = " ".join(text.split()).replace("▽", TRANS)
    if len(text) > W:
        for long, short in SQUEEZE:
            text = text.replace(long, short)
    if len(text) > W:
        text = text.replace(" ", "")
    if len(text) > W:
        text = text[: W - 1] + ">"
    return text.center(W)


def blank_row(n):
    return "|" + "|".join([" " * W] * n) + "|"


def rule(n=6):
    return "+" + "+".join(["-" * W] * n) + "+"


def row_lines(entries, idxs):
    """Up to three stacked lines per key: tap, shifted, hold.

    A line is only emitted if some key in the row uses it, so the sheet does
    not pay three rows of height for the many keys that are just a letter."""
    cols = [legend(entries[i]) for i in idxs]
    out = []
    for slot in range(3):
        if not any(c[slot] for c in cols):
            out.append(None)
            continue
        out.append("|" + "|".join(fit(c[slot]) for c in cols) + "|")
    return out


def encoder_line(field, pair):
    return f"{INDENT}{field:<11}left {pair[0]}     right {pair[1]}"


def draw_layer(name, entries, encoders, extra=()):
    head = f"-- {name.upper()} "
    out = [head + "-" * (WIDTH - len(head)), ""]
    out.append(INDENT + rule() + GAP + rule())

    for r, (lidx, ridx) in enumerate(ROWS):
        left = row_lines(entries, lidx)
        right = row_lines(entries, ridx)
        mid = GAP
        if r == 3:  # the encoder push-buttons live in the gap on this row
            el = legend(entries[ENCODER_BTNS[0]])[0].replace("▽", TRANS)
            er = legend(entries[ENCODER_BTNS[1]])[0].replace("▽", TRANS)
            mid = " " + el[:5].center(5) + er[:5].center(5)
        for slot in range(3):
            if left[slot] is None and right[slot] is None:
                continue
            out.append(INDENT + (left[slot] or blank_row(len(lidx)))
                       + (mid if slot == 0 else GAP)
                       + (right[slot] or blank_row(len(ridx))))
        out.append(INDENT + rule() + GAP + rule())

    # thumbs: 5 per half, left half indented so both clusters sit inboard,
    # the way they do on the keyboard
    left = row_lines(entries, THUMBS[0])
    right = row_lines(entries, THUMBS[1])
    pad = " " * (W + 1)
    out.append(INDENT + pad + rule(5) + GAP + rule(5))
    for slot in range(3):
        if left[slot] is None and right[slot] is None:
            continue
        out.append(INDENT + pad + (left[slot] or blank_row(5))
                   + GAP + (right[slot] or blank_row(5)))
    out.append(INDENT + pad + rule(5) + GAP + rule(5))

    if encoders:
        out.append("")
        out.append(encoder_line("encoders", encoders))
        out.extend(extra)
    out.append("")
    return out


def parse_encoder_pairs():
    """display-name -> [(cw, ccw) left knob, (cw, ccw) right knob], from the .keymap.

    ZMK's `&inc_dec_kp A B` sends A on a clockwise detent and B on a
    counter-clockwise one."""
    src = KEYMAP.read_text()
    found = {}
    for body in re.findall(r"\w+_layer \{(.*?)\n        \};", src, re.S):
        nm = re.search(r'display-name = "([\w-]+)"', body)
        sb = re.search(r"sensor-bindings = <(.*?)>;", body, re.S)
        if not (nm and sb):
            continue  # conditional_layers' adjust_layer has neither
        parts = [p.split() for p in sb.group(1).split("&inc_dec_kp") if p.strip()]
        pairs = [(kc[0], kc[1]) for kc in parts if len(kc) >= 2]
        found[nm.group(1)] = pairs[:2] if len(pairs) >= 2 else None
    return found


def parse_encoders():
    """display-name -> (left, right) encoder description, for keymap.txt."""
    return {name: [f"{cw} / {ccw}" for cw, ccw in pairs] if pairs else None
            for name, pairs in parse_encoder_pairs().items()}


# What a knob keycode means, in words short enough to sit above an encoder
# button -- check_knob_width measures each line against the real gap between
# the halves and fails the run rather than let one print over a key legend.
# Anything missing prints as the raw keycode, which is ugly but never wrong.
# Half-width of a drawn key, from keymap-drawer.yaml's key_h: a square key of
# key_h - 2 * inner_pad_h. The knob text hangs off the top edge of a button.
KEY_R = 33.0

# Line advance and font size per knob-text class, matching svg_extra_style.
KNOB_LINE = {"knob-head": 20, "knob": 18, "knob-alt": 14}
KNOB_EM = {"knob-head": 8, "knob": 11, "knob-alt": 9}

KNOB_WORDS = {
    "C_VOL_UP": "VOL UP", "C_VOL_DN": "VOL DOWN",
    "C_BRI_UP": "BRIGHT UP", "C_BRI_DN": "BRIGHT DN",
    "PG_DN": "PAGE DOWN", "PG_UP": "PAGE UP",
    "LC(RIGHT)": "NEXT WORD", "LC(LEFT)": "PREV WORD",
    "LC(TAB)": "NEXT TAB", "LC(LS(TAB))": "PREV TAB",
    # alt-tab layer: Alt is held by the thumb that reached the layer, so a
    # bare TAB here is the window switcher, not a tab character.
    "TAB": "NEXT WIN", "LS(TAB)": "PREV WIN",
}


def knob_lines(knobs, label=None):
    """The stack of text that sits above one encoder button, bottom line last.

    `label` is the key you hold to get these knob bindings -- set for a folded
    layer's knobs, which ride under the base layer's own.
    """
    cw, ccw = knobs
    pre = f"{label} " if label else ""
    cls = "knob-alt" if label else "knob"
    return [(cls, f"{pre}\u21bb {KNOB_WORDS.get(cw, cw)}"),
            (cls, f"{pre}\u21ba {KNOB_WORDS.get(ccw, ccw)}")]


def draw_knobs(svg):
    """Draw each layer's knob rotation above its encoder push-button.

    keymap-drawer has no concept of encoders, so without this the PNG and SVG
    say nothing about what turning a knob does. The push-buttons (positions 42
    and 43) ARE the knobs physically, and the gap between the halves above them
    is empty on every layer, so each knob's clockwise / counter-clockwise pair
    is stacked right on top of its own button.

    A FOLDED layer has no sheet of its own, so its knobs are appended here to
    the base layer's stack, in the muted `knob-alt` style and prefixed with the
    key you hold to reach them. That is the whole of what such a layer does.

    Runs after fix_baselines, which refuses text it has no legend class for.
    These set their own baseline with plain `y`, which every renderer honours.
    """
    pairs = parse_encoder_pairs()
    folded = [(lbl, pairs.pop(nm)) for nm, lbl in FOLDED.items() if pairs.get(nm)]
    room = knob_room(svg)
    for name, knobs in pairs.items():
        if not knobs:
            continue
        opener = re.search(rf'<g transform="translate\([^)]*\)" class="layer-{name}">', svg)
        if not opener:
            sys.exit(f"draw_knobs: no layer group for {name!r} in the svg")
        out = []
        for i, pos in enumerate(ENCODER_BTNS):
            btn = re.compile(rf'<g transform="translate\(([\d.]+), ([\d.]+)\)" class="[^"]*keypos-{pos}"')
            m = btn.search(svg, opener.end())
            if not m:
                sys.exit(f"draw_knobs: no key {pos} in layer {name!r}")
            x, y = float(m.group(1)), float(m.group(2))

            lines = [("knob-head", "KNOB")] + knob_lines(knobs[i])
            if name == "base":
                for lbl, fk in folded:
                    lines += knob_lines(fk[i], lbl)
            check_knob_width(lines, room, name)

            # stack upward from a baseline just above the key, so the block
            # always hangs off the button no matter how many lines it has
            ty = y - KEY_R - 10
            for cls, text in reversed(lines):
                out.append(f'<text x="{x:g}" y="{ty:g}" class="{cls}">{html.escape(text)}</text>')
                ty -= KNOB_LINE[cls]
        svg = svg[:opener.end()] + "\n" + "\n".join(out) + svg[opener.end():]
    return svg


def knob_room(svg):
    """How wide a knob line may be: centred text, up to the neighbouring key.

    Measured rather than assumed, because the encoder button does NOT sit a
    key pitch from the half beside it -- the split gap widens that column.
    Positions 41 and 42 are the last left-half key and the left button.
    """
    xs = {}
    for pos in (41, 42):
        m = re.search(rf'<g transform="translate\(([\d.]+), [\d.]+\)" class="[^"]*keypos-{pos}"', svg)
        if not m:
            sys.exit(f"knob_room: no key {pos} in the svg")
        xs[pos] = float(m.group(1))
    return 2 * (xs[42] - xs[41] - KEY_R)


def check_knob_width(lines, room, layer):
    """Knob text sits in the empty column between the halves. Keep it there.

    The key columns either side are occupied on the rows this text crosses, so
    a line that outgrows the gap does not wrap or clip -- it prints over a
    legend, which is how it will be discovered if this check is not here.
    """
    for cls, text in lines:
        # monospace: 0.6em advance per character, plus knob-head's letter-spacing
        w = 0.6 * KNOB_EM[cls] * len(text) + (1.0 * len(text) if cls == "knob-head" else 0)
        if w > room:
            sys.exit(f"knob text {text!r} on layer {layer} is {w:.0f}px wide, "
                     f"{w - room:.0f}px more than the {room:.0f}px gap between "
                     f"the halves; shorten it in KNOB_WORDS")


def fit_a4(svg):
    """Give the sheet a real A4 page, so printing it needs no scaling dialog.

    keymap-drawer emits a viewBox in bare user units and width/height to match,
    which a browser prints as an image scaled to the paper -- a 1:2 strip down
    the middle of an A4 page, which is how this sheet used to come out. Setting
    width/height in MILLIMETRES instead makes the user unit a physical length:
    the page is A4, the content is centred inside a real margin, and `print at
    100%` is the whole procedure.
    """
    m = re.search(r'<svg width="([\d.]+)" height="([\d.]+)" viewBox="0 0 ([\d.]+) ([\d.]+)"', svg)
    if not m:
        sys.exit("fit_a4: no viewBox on the svg")
    w, h = float(m.group(3)), float(m.group(4))
    page_w, page_h = A4_MM
    # mm per user unit, whichever of the two margins binds first
    scale = min((page_w - 2 * MARGIN_MM) / w, (page_h - 2 * MARGIN_MM) / h)
    pt = 14 * scale * 72 / 25.4
    if pt < MIN_LEGEND_PT:
        sys.exit(f"the sheet prints its 14px legends at {pt:.1f}pt on A4, under "
                 f"the {MIN_LEGEND_PT}pt floor -- it has grown too tall to stay "
                 f"a one-page reference. Fold a knobs-only layer into base "
                 f"(FOLDED), tighten outer_pad_h, or split the sheet.")
    # the page, in the same user units, with the content centred in it
    ox, oy = (page_w / scale - w) / 2, (page_h / scale - h) / 2
    return (svg.replace(m.group(0),
                        f'<svg width="{page_w:g}mm" height="{page_h:g}mm" '
                        f'viewBox="{-ox:.1f} {-oy:.1f} {page_w / scale:.1f} '
                        f'{page_h / scale:.1f}"', 1), pt)


def render(km):
    encoders = parse_encoders()
    lines = [
        "SOFLE MX 58 - KEYMAP CHEATSHEET",
        "",
        "Generated from sofle.keymap by scripts/gen-keymap-art.",
        "Do not edit by hand - edit the keymap and regenerate.",
        "",
        "Each key stacks up to three lines:",
        "    1  tap        what the key sends",
        "    2  shifted    what Shift gives (punctuation / symbols)",
        "    3  hold       what holding it gives (modifier names)",
        "A line is omitted when no key in that row uses it.",
        "",
        f"    {TRANS}   transparent - falls through to the layer below",
        "    HELD  the key you are holding to be on this layer",
        "    blank nothing bound",
        "",
        "The two keys between the halves are the ENCODER PUSH-BUTTONS.",
        "",
    ]
    # A knobs-only layer has no sheet of its own here either -- 60 transparent
    # cells say nothing. Its knobs print under base's, same shape, labelled
    # with the key you hold. See FOLDED.
    folded = [encoder_line(f"hold {lbl}", encoders[nm])
              for nm, lbl in FOLDED.items() if encoders.get(nm)]
    for name, entries in km["layers"].items():
        if len(entries) != 60:
            sys.exit(f"layer {name}: expected 60 bindings, got {len(entries)}")
        if name in FOLDED:
            continue
        lines += draw_layer(name, entries, encoders.get(name),
                            folded if name == "base" else ())

    combos = km.get("combos") or []
    if combos:
        head = "-- COMBOS "
        lines += [head + "-" * (WIDTH - len(head)), ""]
        for c in combos:
            k = c["k"] if isinstance(c["k"], str) else c["k"].get("t", "?")
            where = ",".join(c.get("l", [])) or "all layers"
            lines.append(f"{INDENT}positions {str(c['p']):12} -> {k:8} ({where})")
        lines.append("")

    head = "-- NOTES "
    lines += [
        head + "-" * (WIDTH - len(head)),
        "",
        "  Home-row mods are GACS: GUI Alt Ctrl Shift, going inward, mirrored.",
        "  They only resolve as a hold if the next key is on the OTHER hand, and",
        "  only after 150ms of idle - so same-hand rolls still type letters.",
        "",
        "  Alt+hjkl walks nvim splits and tmux panes as one space - a",
        "  left-hand hold plus a right-hand tap, no layer needed.",
        "",
        "  The Ctrl+b prefix (tmux and herdr) is the exception: b is a LEFT-half",
        "  key, so the cross-hand guard refuses a left home-row Ctrl and you get",
        "  \"db\". Use either bottom-row corner Ctrl.",
        "",
        "  Hold NAV + MEDIA (or NAV + RET) for the ADJ layer.",
        "",
        "  The bottom-row corners are Ctrl, not Shift. Home-row Ctrl is on D",
        "  behind the cross-hand guard, so it can only fire with a right-hand",
        "  key - every left-hand Ctrl chord (<C-d> <C-u> <C-w> <C-r> <C-v>,",
        "  and Ctrl+b) needs a guard-free corner Ctrl. Shift moved one",
        "  row down to the thumb keys.",
        "",
        "  Both Shift keys together = caps word: UVM_INFO and SCREAMING_PARAMS",
        "  type in one gesture and end themselves at the space.",
        "",
        "  Of a TKL's right-side overflow, [ and ] are on base - [ where a TKL",
        "  has it, after P, and ] on the bottom-right corner. Shift composes,",
        "  so { and } (paragraph motions) are one gesture. Only \\ and = stay",
        "  layer-bound: NAV+8 is \\, NAV+- is =, and , + . is also \\. NAV",
        "  keeps [ and ] as well, as a fallback.",
        "",
    ]

    # The whole point of ASCII here is that it lines up in any terminal.
    for n, line in enumerate(lines, 1):
        if not line.isascii():
            sys.exit(f"line {n} is not ASCII: {line!r}")
    # Two groups, not one: the thumb clusters are deliberately inboard on both
    # halves (that is where they are on the keyboard), so they are narrower
    # than the main grid by exactly one cell. Each group must be internally
    # square.
    pad = " " * (W + 1)
    main = [l for l in lines if l.startswith((INDENT + "|", INDENT + "+"))]
    thumb = [l for l in lines if l.startswith((INDENT + pad + "|", INDENT + pad + "+"))]
    for label, group, expect in (("main", main, WIDTH),
                                 ("thumb", thumb, WIDTH - (W + 1))):
        bad = {len(l) for l in group} - {expect}
        if bad:
            sys.exit(f"{label} grid lines are not {expect} wide: {sorted(bad)}")
    return "\n".join(lines) + "\n"


def stamp_base_reference(km):
    """Put the base-layer legend in each key's bottom-left corner, per layer.

    A layer sheet is a picture of the same keys as the base one, but a
    held-layer legend tells you what a key DOES there, not which key it is --
    and on NAV most of the board is a transparent glyph, which tells you
    neither.
    So every key on every layer but base carries what base has in that slot, in
    the bottom-left corner and muted (see keymap-drawer.yaml): read the middle
    for the layer, read the corner to find the key under your finger.

    Bottom-left is the one free corner: shifted goes top-centre, hold
    bottom-centre, and no layer but base has holds anyway.
    """
    base = km["layers"]["base"]
    for name, entries in km["layers"].items():
        if name == "base":
            continue
        for i, entry in enumerate(entries):
            ref = legend(base[i])[0]
            if not ref:
                continue  # nothing bound on base either
            if not isinstance(entry, dict):
                entry = entries[i] = {"t": str(entry)}
            entry["bl"] = ref


def lay_out_combos(km):
    """Size every combo box to the legend it actually holds.

    A combo box is drawn ON the board, between the keys that trigger it, so it
    competes for space with their legends -- and keymap-drawer gives every box
    one size, which has to be wide enough for the longest legend (CAPSWRD) and
    is then far too wide for `[`. Both of the things that looked wrong came out
    of that single size: an oversized box covered the neighbouring key's legend
    (`/` + the bottom-right corner sat on that corner's RCTRL), and a box short
    enough not to collide vertically had its own two legends collide instead
    (`=` over `+` rendered as a `±` blob).

    So each box gets its own: wide enough for its own text plus PAD, and tall
    enough for a stacked shifted face only when it has one. The widest box that
    sits between two keys then reaches 18px into them, and the closest a key
    legend gets to that boundary is 14px on the worst key on the board (a
    5-character 14px legend, centred, one key-pitch away) -- so nothing
    overlaps anything, and the legends stack the way they do on a key.
    """
    PAD, MIN_W, CHAR_W = 10, 24, 0.6 * 11   # 11px is keymap-drawer's combo font
    TAP_ONLY_H = 26                         # keymap-drawer's own default
    for combo in km.get("combos") or []:
        key = combo.get("k")
        key = key if isinstance(key, dict) else {"t": str(key)}
        combo["w"] = max(MIN_W, round(CHAR_W * len(key.get("t", ""))) + PAD)
        # Height is left to `combo_h` when there are two legends, because
        # keymap-drawer positions them from that value whatever this box's
        # height is -- the two have to agree (see keymap-drawer.yaml). A
        # tap-only box is drawn centred, so it can lose the top row.
        if not key.get("s"):
            combo["h"] = TAP_ONLY_H


def fix_baselines(svg):
    """Re-do the SVG's vertical text placement with `dy`. See LEGEND_DY."""
    style = svg[svg.index("<style>"):svg.index("</style>")]
    for expect in ("dominant-baseline: middle", "dominant-baseline: hanging"):
        if expect not in style:
            sys.exit(f"keymap-drawer no longer emits `{expect}` -- it may have "
                     "fixed this itself; re-check LEGEND_DY before regenerating")

    def patch(match):
        block = match.group(0)
        classes = re.search(r'class="([^"]*)"', block)
        found = [c for c in (classes.group(1).split() if classes else [])
                 if c in LEGEND_DY]
        if len(found) != 1:
            sys.exit(f"cannot place text, {len(found)} known legend classes: {block!r}")
        dy = LEGEND_DY[found[0]]
        if not dy:
            return block
        # Always hang the offset on the first <tspan> when there is one: its
        # em is the (possibly shrunk) size the glyphs actually render at, and
        # librsvg applies a dy on the parent <text> once PER tspan while
        # browsers apply it once -- so parent dy on a multi-line legend would
        # reintroduce exactly the kind of renderer split this is undoing.
        if (tspan := re.search(r"<tspan\b[^>]*>", block)) is None:
            return block.replace("<text ", f'<text dy="{dy}em" ', 1)
        tag = tspan.group(0)
        if (own := re.search(r'dy="(-?[\d.]+)em"', tag)):
            new = tag.replace(own.group(0), f'dy="{float(own.group(1)) + dy:.3g}em"')
        else:
            new = tag.replace("<tspan ", f'<tspan dy="{dy}em" ', 1)
        return block.replace(tag, new, 1)

    return re.sub(r"<text\b.*?</text>", patch, svg, flags=re.S)


def check_footer(svg):
    """The footer is one right-aligned line that nothing wraps or measures."""
    foot = re.search(r'<text x="([\d.]+)"[^>]*class="footer">([^<]*)</text>', svg)
    if not foot:
        return
    x, text = float(foot.group(1)), foot.group(2)
    # The sheet is set in a monospace stack at 14px; 0.6em per character is the
    # advance width of every one of them.
    if (left := x - 0.6 * 14 * len(text)) < 0:
        sys.exit(f"footer_text runs {-left:.0f}px off the left edge of the "
                 f"sheet ({len(text)} chars); shorten it in {DRAWER_CFG.name}")


def main():
    try:
        import yaml
    except ImportError:
        sys.exit("need PyYAML: pip install keymap-drawer")

    if not DRAWER_CFG.exists():
        sys.exit(f"missing {DRAWER_CFG}")

    print("parsing keymap ...")
    parsed = run("keymap", "-c", str(DRAWER_CFG), "parse", "-z", str(KEYMAP))
    km = yaml.safe_load(parsed)

    print("drawing svg ...")
    drawn = copy.deepcopy(km)
    for nm in FOLDED:
        drawn["layers"].pop(nm, None)
    stamp_base_reference(drawn)
    lay_out_combos(drawn)
    svg = HERE / "keymap.svg"
    drawn_svg = fix_baselines(run(
        "keymap", "-c", str(DRAWER_CFG), "draw", "-",
        input=yaml.safe_dump(drawn, sort_keys=False, allow_unicode=True),
    ))
    drawn_svg = draw_knobs(drawn_svg)
    check_footer(drawn_svg)
    drawn_svg, pt = fit_a4(drawn_svg)
    svg.write_text(drawn_svg)
    print(f"  A4 portrait, {MARGIN_MM:g}mm margins, legends at {pt:.1f}pt")

    png = HERE / "keymap.png"
    try:
        # the svg is sized in mm now, so a dpi is all the PNG needs to come
        # out as the same page at a printable resolution
        run("rsvg-convert", "-b", "white", "-d", str(PNG_DPI), "-p", str(PNG_DPI),
            str(svg), "-o", str(png))
        print("drawing png ...")
    except (FileNotFoundError, subprocess.CalledProcessError):
        print("rsvg-convert not found - skipping PNG (install librsvg2-bin)")

    print("writing ascii ...")
    (HERE / "keymap.txt").write_text(render(km))
    print("done: keymap.svg  keymap.png  keymap.txt")


if __name__ == "__main__":
    main()
