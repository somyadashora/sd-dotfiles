#!/usr/bin/env bash
# slang-init -- bootstrap slang-server config for a SystemVerilog project.
#
# Creates, at the project root:
#   .slang/             config dir (also the LSP root marker)
#   .slang/<name>.f     filelist of sources + flags, generated from your RTL dir
#   .slang/server.json  workspace config pointing at the filelist
# and appends .slang/local/ to .gitignore.
#
# index vs build: `index`+`flags` give hover/def/refs/diagnostics. Driver/load
# cone tracing (<leader>Sd / <leader>Sl) needs an elaborated `build` with a top
# module. Pass -t/--top to bake `--top` into the filelist AND add a `build`
# entry to server.json so tracing works out of the box.
#
# Usage:
#   slang-init                  # scan ./rtl  -> .slang/rtl.f
#   slang-init -d src           # scan ./src  -> .slang/src.f
#   slang-init -d . -t VtIommu  # set --top + build -> enables cone tracing
#   slang-init --build          # add a build entry without changing the top
#   slang-init --force          # overwrite existing .slang files
#   slang-init --regen-only     # only rebuild the .f filelist, keep server.json
#
# Run from the project root. Re-run after adding/removing source files to
# refresh the filelist.
set -euo pipefail

dir="rtl"
top=""
force=0
regen_only=0
build=0

usage() { sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    -d|--dir)        dir="${2:?-d needs a directory}"; shift 2 ;;
    -t|--top)        top="${2:?-t needs a module name}"; shift 2 ; build=1 ;;
    -b|--build)      build=1; shift ;;
    -f|--force)      force=1; shift ;;
    --regen-only)    regen_only=1; shift ;;
    -h|--help)       usage 0 ;;
    *) echo "slang-init: unknown arg '$1'" >&2; usage 1 ;;
  esac
done

dir="${dir%/}"
if [[ ! -d "$dir" ]]; then
  echo "slang-init: source dir '$dir' not found (run from project root, or pass -d DIR)" >&2
  exit 1
fi

# name the filelist after the real dir (handles `.` -> project dir name)
name="$(basename "$(cd "$dir" && pwd)")"
flist=".slang/${name}.f"
conf=".slang/server.json"

# never sweep these into the filelist (vcs, our own config, common build dirs)
prune=(-name .git -o -name .slang -o -name build -o -name sim -o -name work)

mkdir -p .slang

# --- generate the .f filelist -------------------------------------------------
if [[ -e "$flist" && $force -eq 0 ]]; then
  echo "slang-init: $flist exists -- use --force to overwrite" >&2
else
  {
    # include dirs: the RTL dir plus every dir containing a .svh header
    echo "-I $dir"
    find "$dir" \( "${prune[@]}" \) -prune -o -type f -name '*.svh' -printf '%h\n' \
      | sort -u | grep -vx "$dir" | sed 's/^/-I /' || true
    [[ -n "$top" ]] && echo "--top $top"
    echo
    # compile units: .sv / .v (headers come in via -I, so not listed)
    find "$dir" \( "${prune[@]}" \) -prune -o -type f \
      \( -name '*.sv' -o -name '*.v' \) -print | sort
  } > "$flist"
  echo "slang-init: wrote $flist ($(grep -cE '\.(sv|v)$' "$flist") source files)"
fi

[[ $regen_only -eq 1 ]] && exit 0

# --- generate the workspace config -------------------------------------------
if [[ -e "$conf" && $force -eq 0 ]]; then
  echo "slang-init: $conf exists -- use --force to overwrite" >&2
else
  build_line=""
  if [[ $build -eq 1 ]]; then
    build_line=",
  \"build\": \"$flist\""
    [[ -z "$top" ]] && echo "slang-init: WARN build enabled without --top; cone tracing needs a top module in $flist" >&2
  fi
  cat > "$conf" <<JSON
{
  "flags": "-f $flist",
  "index": [
    { "dirs": ["$dir"] }
  ]$build_line
}
JSON
  echo "slang-init: wrote $conf$([[ $build -eq 1 ]] && echo ' (with build -> cone tracing enabled)')"
fi

# --- ignore personal local overrides -----------------------------------------
if [[ -f .gitignore ]] && grep -qxF ".slang/local/" .gitignore; then
  :
else
  echo ".slang/local/" >> .gitignore
  echo "slang-init: added .slang/local/ to .gitignore"
fi

echo "slang-init: done. Open a file under $dir/ and run :UseSlang, then :checkhealth vim.lsp"
