#!/usr/bin/env bash
# verible-init -- bootstrap verible-verilog-ls config for a SystemVerilog project.
#
# Creates, at the project root:
#   verible.filelist     line-by-line list of .sv/.svh/.v sources. Enables
#                        project-wide go-to-def, references and hover. The LS
#                        looks for this name in the project root (override with
#                        --file_list_path). Verible has NO +incdir+ handling,
#                        so header (.svh) files are listed here too, not as -I.
#   .verible_format      starter formatter config (a --flagfile: one --flag=value
#                        per line, '#' comments). Always written. The nvim config
#                        auto-detects it by walking up parent dirs; use it from
#                        the CLI with: verible-verilog-format --flagfile=.verible_format
#   .rules.verible_lint  (with --rules) starter lint config. The nvim config
#                        runs verible with --rules_config_search, which walks up
#                        parent dirs looking for this file.
#
# Verible needs no build/elaboration (unlike slang) -- the filelist alone gives
# the full cross-file experience.
#
# Usage:
#   verible-init                # scan ./rtl  -> ./verible.filelist
#   verible-init -d .           # scan current dir
#   verible-init -d src         # scan ./src
#   verible-init --rules        # also scaffold .rules.verible_lint
#   verible-init --force        # overwrite existing files
#
# Run from the project root. Re-run after adding/removing sources to refresh.
set -euo pipefail

dir="rtl"
force=0
rules=0

usage() { sed -n '2,28p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    -d|--dir)     dir="${2:?-d needs a directory}"; shift 2 ;;
    -r|--rules)   rules=1; shift ;;
    -f|--force)   force=1; shift ;;
    -h|--help)    usage 0 ;;
    *) echo "verible-init: unknown arg '$1'" >&2; usage 1 ;;
  esac
done

dir="${dir%/}"
if [[ ! -d "$dir" ]]; then
  echo "verible-init: source dir '$dir' not found (run from project root, or pass -d DIR)" >&2
  exit 1
fi

# never sweep these into the filelist (vcs, common build/output dirs)
prune=(-name .git -o -name build -o -name sim -o -name work)

# --- generate verible.filelist -----------------------------------------------
flist="verible.filelist"
if [[ -e "$flist" && $force -eq 0 ]]; then
  echo "verible-init: $flist exists -- use --force to overwrite" >&2
else
  find "$dir" \( "${prune[@]}" \) -prune -o -type f \
    \( -name '*.sv' -o -name '*.svh' -o -name '*.v' \) -print | sort > "$flist"
  echo "verible-init: wrote $flist ($(wc -l < "$flist") files)"
fi

# --- formatter config (--flagfile) -------------------------------------------
ffile=".verible_format"
if [[ -e "$ffile" && $force -eq 0 ]]; then
  echo "verible-init: $ffile exists -- use --force to overwrite" >&2
else
  cat > "$ffile" <<'FORMAT'
# Verible SystemVerilog formatter config.
# Used by Neovim (auto-detected) and: verible-verilog-format --flagfile=.verible_format
# One --flag=value per line; '#' starts a comment.
# Full reference: https://chipsalliance.github.io/verible/verilog_format.html

# --- Indentation & line width -------------------------------------------------
--column_limit=100
--indentation_spaces=2
--wrap_spaces=4

# --- Alignment: align | flush-left | preserve | infer -------------------------
--assignment_statement_alignment=align
--enum_assignment_statement_alignment=align
--module_net_variable_alignment=align
--class_member_variable_alignment=align
--struct_union_members_alignment=align
--case_items_alignment=align
--port_declarations_alignment=align
--named_parameter_alignment=align
--named_port_alignment=align
--formal_parameters_alignment=align

# --- Line wrapping ------------------------------------------------------------
--port_declarations_indentation=wrap
--formal_parameters_indentation=wrap
--try_wrap_long_lines=true
--wrap_end_else_clauses=false
FORMAT
  echo "verible-init: wrote $ffile"
fi

# --- optional starter lint rules ---------------------------------------------
if [[ $rules -eq 1 ]]; then
  rfile=".rules.verible_lint"
  if [[ -e "$rfile" && $force -eq 0 ]]; then
    echo "verible-init: $rfile exists -- use --force to overwrite" >&2
  else
    cat > "$rfile" <<'RULES'
# verible lint rules: +enable / -disable, one per line (or comma-separated).
# Full list: https://chipsalliance.github.io/verible/lint.html
# Below are common noise-reducers for existing RTL -- tune to taste.
-line-length
-no-tabs
RULES
    echo "verible-init: wrote $rfile"
  fi
fi

echo "verible-init: done. Open a file under $dir/ and run :UseVerible, then :checkhealth vim.lsp"
