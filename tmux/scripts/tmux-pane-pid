#!/bin/sh
# Print the PID of the FOREGROUND process on a pane's tty — the program you're
# actually looking at (e.g. nvim), not the pane's root shell. tmux exposes
# `pane_pid` (the shell tmux forked for the pane) but has no format var for the
# foreground process's pid, so pane-border-format shells out here to show
# "1/2 nvim 87629".
#
# The tty's foreground process group id (tpgid) names the running job; its group
# leader — the row whose pid == tpgid — is that program. Output is a single
# " <pid>" (leading space) so the caller can append it with no stray spacing,
# and nothing at all on any error, so the pill degrades to just the command name
# when ps/the tty misbehave (graceful degradation).
tty=${1#/dev/}
[ -n "$tty" ] || exit 0

pid=$(ps -t "$tty" -o pid=,tpgid= 2>/dev/null | awk '$1 == $2 { print $1; exit }')
[ -n "$pid" ] && printf ' %s' "$pid"
exit 0
