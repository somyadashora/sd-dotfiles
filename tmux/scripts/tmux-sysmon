#!/usr/bin/env bash
# tmux-sysmon -- open a system-wide health monitor window.
#
# Creates (or replaces) a tmux window named "sysmon" with three panes:
#
#   +---------------------------+---------------------------+
#   | htop (whole system,       | RAM: free -h summary +    |
#   | sorted by CPU)            | top 15 procs by RSS       |
#   | (fallback: top)           | (refreshed every 2s)      |
#   +---------------------------+---------------------------+
#   | bottleneck vitals: load vs cores, PSI cpu/mem/io      |
#   | pressure, swap in/out + iowait, D-state (stuck-on-IO) |
#   | processes, root-disk usage -- refreshed every 2s      |
#   +-------------------------------------------------------+
#
# The vitals pane is the "what is slowing the system down" answer:
#   load > cores          -> CPU oversubscribed
#   PSI memory/io avg10   -> % of time tasks stalled waiting on RAM / disk
#   si/so (swap) nonzero  -> thrashing; wa (iowait) high -> disk-bound
#   D-state processes     -> the exact tasks stuck in uninterruptible IO
#
# System-wide sibling of tmux-watch (which monitors one process).
# Killing the sysmon window never touches anything.
#
# Usage:
#   tmux-sysmon           # open/replace the sysmon window (alias: watchsys)
set -u

SELF="$(readlink -f "$0")"

die() {
  tmux display-message "tmux-sysmon: $*" 2>/dev/null
  echo "tmux-sysmon: $*" >&2
  exit 1
}

# ── internal mode: --mem → the RAM pane's refresh loop ──────────────────────
mem_pane() {
  while :; do
    local out
    out="── memory ──────────────────────────────────────────
$(free -h)

── top 15 by resident RAM ──────────────────────────
$(ps -eo pid,user,rss,pmem,comm --sort=-rss 2>/dev/null \
    | awk 'NR==1 {printf "%7s %-10s %9s %5s %s\n", $1, $2, "RSS", $4, $5; next}
           NR<=16 {printf "%7s %-10s %8.1fM %5s %s\n", $1, $2, $3/1024, $4, $5}')"
    clear
    printf '%s\n' "$out"
    sleep 2
  done
}

# ── internal mode: --vitals → the bottom pane's refresh loop ────────────────
psi_line() { # psi_line cpu|memory|io
  awk -v k="$1" '/^some/ {
    for (i = 2; i <= NF; i++) if ($i ~ /^avg(10|60)=/) printf " %s", $i
  }' "/proc/pressure/$1" 2>/dev/null
}

vitals() {
  local cores
  cores=$(nproc 2>/dev/null || echo "?")
  while :; do
    # vmstat 1 2: second sample = "now", not average-since-boot
    local vm si so wa psi_cpu psi_mem psi_io dstate out
    vm=$(vmstat 1 2 2>/dev/null | tail -1)
    si=$(echo "$vm" | awk '{print $7}')
    so=$(echo "$vm" | awk '{print $8}')
    wa=$(echo "$vm" | awk '{print $16}')
    psi_cpu=$(psi_line cpu); psi_mem=$(psi_line memory); psi_io=$(psi_line io)
    dstate=$(ps -eo pid,stat,comm 2>/dev/null \
      | awk '$2 ~ /^D/ {printf "  %s %s (%s)", $1, $3, $2}')
    out="── system bottlenecks ──────────────────────────────────────
load:    $(cut -d' ' -f1-3 /proc/loadavg)  (1/5/15 min, $cores cores)
$(if [ -n "$psi_cpu$psi_mem$psi_io" ]; then
    printf 'stall%%:  cpu%s   mem%s   io%s  (PSI: %% of time tasks waited)' \
      "$psi_cpu" "$psi_mem" "$psi_io"
  else
    printf 'stall%%:  PSI not available on this kernel'
  fi)
swap:    in ${si:-?} kB/s   out ${so:-?} kB/s   iowait ${wa:-?}%
disk /:  $(df -h / 2>/dev/null | awk 'NR==2 {printf "%s used of %s (%s)", $3, $2, $5}')
D-state: ${dstate:-none  (no processes stuck in uninterruptible IO)}"
    clear
    printf '%s\n' "$out"
    # vmstat already spent ~1s sampling; top up to a ~2s cycle
    sleep 1
  done
}

case "${1:-}" in
  --mem)    mem_pane; exit 0 ;;
  --vitals) vitals;   exit 0 ;;
  -h|--help) sed -n '2,28p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

# ── create / replace the sysmon window ──────────────────────────────────────
# Query tmux directly rather than requiring $TMUX: run-shell (prefix+M) may not
# export it, but the server is always reachable from there.
sess=$(tmux display -p '#{session_name}' 2>/dev/null) || die "run inside tmux"

if command -v htop >/dev/null 2>&1; then
  cmd_cpu="htop"
else
  cmd_cpu="top"
fi

tmux list-windows -t "$sess" -F '#{window_id} #{window_name}' 2>/dev/null \
  | awk '$2 == "sysmon" {print $1}' \
  | xargs -r -n1 tmux kill-window -t

# Address panes by ID (not index) so this works with any pane-base-index.
p0=$(tmux new-window -t "$sess" -P -F '#{pane_id}' -n "sysmon" "$cmd_cpu")
tmux split-window -t "$p0" -v -l '30%' "'$SELF' --vitals"
tmux split-window -t "$p0" -h "'$SELF' --mem"
tmux select-pane -t "$p0"
